# ---------------------------------------------------------------
# ReviewLens server configuration. Copy to `.env` (repo root) and
# fill in the values. NEVER commit the real `.env` file.
# These values are read by the server only; the browser never sees them.
# ---------------------------------------------------------------

# --- LLM provider (any OpenAI-compatible Chat Completions API) ---
# Groq (free tier):       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
# OpenRouter (free):      LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<a model id ending in :free>
# Gemini (OpenAI compat): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
# Ollama (local, no key): LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Per-request timeout and network/rate-limit retry policy
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY_MS=1000
LLM_RETRY_MAX_DELAY_MS=30000

# Reviews sent to the LLM per request (processed sequentially)
ANALYSIS_BATCH_SIZE=5

# --- Optional fallback LLM provider ---
# Used when the primary times out or fails (the primary then gets only 1 retry
# and is skipped for LLM_FALLBACK_COOLDOWN_MS). Leave LLM_API_KEY2 empty to disable.
LLM_API_KEY2=
LLM_BASE_URL2=https://integrate.api.nvidia.com/v1
LLM_MODEL2=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT_MS2=60000
LLM_FALLBACK_COOLDOWN_MS=60000

# --- Server ---
PORT=4000
# Graceful shutdown: how long to wait for the AI batch in flight to be saved
SHUTDOWN_TIMEOUT_MS=30000
# Comma-separated list of browser origins allowed by CORS (dev client runs on 5173)
CORS_ORIGINS=http://localhost:5173
# SQLite file location (relative paths resolve from the server/ folder)
DATABASE_PATH=./data/reviewlens.db
# Upload limits
MAX_UPLOAD_MB=2
MAX_CSV_ROWS=5000
