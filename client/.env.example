# Frontend build settings. Vite only exposes variables that start with VITE_,
# and bakes them into the bundle at BUILD time (changing them needs a rebuild/redeploy).
# These values are public: never put API keys here (keys live in the server's .env).

# Backend origin for split deployments (e.g. Vercel frontend + Render backend).
# Leave EMPTY when the UI and API share one origin: `npm run dev` (Vite proxy),
# Docker (nginx proxy) or `npm start` (Express serves the UI).
# Do not add /api at the end; every request path already starts with /api.
#   VITE_API_BASE_URL=https://cedcolens-api.onrender.com
VITE_API_BASE_URL=

# Dev only: where the Vite dev server proxies /api (default http://localhost:4000).
# VITE_PROXY_TARGET=http://localhost:4000
